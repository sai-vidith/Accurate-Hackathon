# Copy this file to `.env` (same folder) and paste your keys. Never commit `.env`.

# --- AI (main): Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq model that supports tool calling; check the model list in your Groq console.
GROQ_MODEL=openai/gpt-oss-120b

# --- AI (backup): Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- openrouteservice (free) — https://openrouteservice.org/dev/#/signup
# Nearby places (POIs with opening hours), travel times, road routes for the map, road alternatives.
# Geocoding uses OpenStreetMap Nominatim via geopy (no key needed).
ORS_API_KEY=

# Order to try AI providers. If all fail, the app uses built-in template explanations.
LLM_PROVIDER_ORDER=groq,gemini

# --- Login (JWT)
# Secret used to sign login tokens. Leave empty to auto-generate one into backend/data/.jwt_secret.
JWT_SECRET=
# Admin account (can open the Activity monitor). If empty, the first account you create becomes the admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Database (optional). Empty = JSON files in backend/data. For deployment, a free Neon Postgres connection string:
# postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Deployment (optional): the website's address when it is hosted elsewhere (e.g. Netlify), comma-separated.
ALLOWED_ORIGINS=
